{
  "name": "sakura-site",
  "private": true,
  "scripts": {
    "build": "esbuild src/doodle-entry.tsx --bundle --minify --format=iife --target=es2019 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=site/assets/doodle.js",
    "typecheck": "tsc --noEmit",
    "build:css": "tailwindcss -i src/tw.css -o site/assets/tw.css --minify",
    "build:all": "npm run build:css && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.6.3"
  }
}
